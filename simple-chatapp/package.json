{
  "name": "simple-chatapp",
  "version": "1.0.0",
  "type": "module",
  "description": "A simple chat application with Claude Agent SDK",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/server.ts",
    "dev:client": "vite --port 5173",
    "start": "tsx server/server.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "demo:start": "node scripts/start.mjs",
    "demo:stop": "node scripts/stop.mjs",
    "demo:verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.1.77",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-use-websocket": "4.13.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "22.19.0",
    "@types/react": "18.3.25",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.4.21",
    "concurrently": "9.2.5",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24"
  }
}
